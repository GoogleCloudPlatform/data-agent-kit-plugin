{
  "mcpServers": {
    "notebook": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/dist/index.js",
        "--mode=notebook"
      ],
      "env": {},
      "env_vars": [
        "DATA_CLOUD_CURR_IDE_NAME"
      ]
    },
    "visualization": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/dist/index.js",
        "--mode=visualization"
      ],
      "env": {},
      "env_vars": [
        "DATA_CLOUD_CURR_IDE_NAME"
      ]
    },
    "bigquery": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://bigquery.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "spanner": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://spanner.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "alloydb-postgres": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://alloydb.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "cloud-sql-postgresql": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://sqladmin.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "knowledge_catalog": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://dataplex.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "dataproc": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://dataproc-$GCP_REGION.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "bigtable": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://bigtableadmin.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    },
    "cloud-storage": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://storage.googleapis.com/storage/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.codex\"}"
      }
    }
  }
}
